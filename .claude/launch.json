{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "remotion",
        "studio",
        "src/index.ts",
        "--no-open",
        "--port",
        "3123"
      ],
      "port": 3123
    },
    {
      "name": "api-local",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "C:/Users/onurc/source/repos/sinavika/API/API.csproj",
        "--launch-profile",
        "http"
      ],
      "port": 5025,
      "url": "http://localhost:5025"
    },
    {
      "name": "web-local",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "C:/Users/onurc/source/repos/sinavika_frontend_student",
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "admin-local",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set VITE_API_BASE_URL=http://localhost:5025&& cd /d C:/Users/onurc/source/repos/sinavika_frontend_admin&& npx vite --port 3000 --strictPort"
