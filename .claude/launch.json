      "runtimeArgs": [
        "/c",
        "set EXPO_PUBLIC_API_BASE_URL=http://localhost:5025&& cd /d C:/Users/onurc/Desktop/sinavika_mobile_reactnative&& npx expo start --dev-client --localhost --port 8081"
      ],
      "port": 8081
    }
  ]
