{
  "name": "sinavika-video-engine",
  "version": "0.1.0",
  "description": "Sınavika için veri odaklı, Remotion tabanlı eğitim videosu üretim motoru",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "tsx scripts/RenderVideo.ts",
    "render:samples": "tsx scripts/RenderSamples.ts",
    "stills": "tsx scripts/RenderStills.ts",
    "validate": "tsx scripts/ValidateJob.ts",
    "schema": "tsx scripts/PrintSchema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:render": "vitest run --config vitest.render.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/media-parser": "^4.0.534",
    "@remotion/renderer": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "katex": "0.19.0",
    "msedge-tts": "^2.0.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^5.0.3"
  }
}
