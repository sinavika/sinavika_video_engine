# .env dosyasina kopyalayip kendi anahtarinizi yazin.
ELEVENLABS_API_KEY=

# Sinavika API (SocialHub) icerik teslimi. Anahtar sunucudaki SocialHub__ClaudeApiKey ile ayni olmali.
SINAVIKA_API_URL=https://api.sinavika.com
SINAVIKA_SOCIALHUB_KEY=
# "on" yazilirsa kamp videosu yalniz admin panelde onaylanan senaryo surumunden render edilir (npm run camp).
SINAVIKA_CAMP_RENDER_GATE=
