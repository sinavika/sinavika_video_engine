<Project>
  <!-- The build goes to Outputs/QuestionRevision/FigureCheck: nothing generated stays in Curriculum. -->
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\..\..\Outputs\QuestionRevision\FigureCheck\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\..\..\Outputs\QuestionRevision\FigureCheck\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
