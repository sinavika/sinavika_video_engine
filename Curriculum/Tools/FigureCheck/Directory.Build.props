<Project>
  <!-- The build goes to Outputs/Quizzes/FigureCheck: nothing generated stays in Curriculum. -->
  <PropertyGroup>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\..\Outputs\Quizzes\FigureCheck\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\..\Outputs\Quizzes\FigureCheck\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
