    "cards": [
     {
      "kind": "rule",
      "title": "Köşegen, çevre ve alan",
      "items": [
       "Kenarlar $a$, $b$: köşegen $d^2 = a^2 + b^2$.",
       "Çevre $2(a + b)$, alan $a \\cdot b$.",
       "$(a + b)^2 = a^2 + b^2 + 2ab$: çevre ve köşegenden alan bulunur."
      ],
      "beats": [],
      "narration": "Kenarları a ve b olan dikdörtgende köşegen, Pisagor ile bulunur: d kare, a kare artı b kare. Çevre iki çarpı a artı b, alan a çarpı b. Bu üçünü bir özdeşlik bağlar: a artı b'nin karesi, a kare artı b kare artı iki a b. Yani çevreyi ve köşegeni biliyorsan, kenarları tek tek bulmadan alanı bulursun."
     },
     {
      "kind": "question",
      "question": {
