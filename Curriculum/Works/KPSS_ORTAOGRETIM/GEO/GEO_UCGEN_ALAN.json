   "Taban ve yükseklikle alan hesaplamak",
   "Dik ve eşkenar üçgenin alanını bulmak",
   "Ortak yükseklikte alan oranlarını kullanmak",
   "Benzer üçgenlerde alan oranını uygulamak",
   "Alan paylaşımı kurallarını kullanmak"
  ],
